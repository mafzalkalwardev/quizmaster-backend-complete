<!DOCTYPE html>
<html>
<head>
    <title>QuizMaster</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="/style.css">
</head>
<body>

<div class="navbar">
    <h1>QuizMaster</h1>

    <div>
        <a href="/quizzes">Home</a>
        <a href="/leaderboardPage">Leaderboard</a>
    </div>
</div>

<div class="container">

    <div class="form-box">
        <h2>Create Quiz</h2>

        <form action="/quizzes" method="POST">

            <input type="text" name="title" placeholder="Quiz Title" required>

            <input type="text" name="category" placeholder="Category" required>

            <input type="number" name="totalMarks" placeholder="Total Marks" required>

            <button type="submit">Add Quiz</button>

        </form>
    </div>

    <div class="quiz-list">

        <h2>Available Quizzes</h2>

        <% quizzes.forEach(q => { %>

            <div class="card">

                <h3><%= q.title %></h3>

                <p><strong>Category:</strong> <%= q.category %></p>

                <p><strong>Total Marks:</strong> <%= q.totalMarks %></p>

                <div class="btn-group">
                    <a class="btn" href="/questions/<%= q._id %>">Start Quiz</a>

                    <form action="/quizzes/<%= q._id %>/delete" method="POST">
                        <button class="delete-btn" type="submit">Delete</button>
                    </form>
                </div>

            </div>

        <% }) %>

    </div>

</div>

</body>
</html>
